# ============================================
# DocuEase — Environment Variables (TEMPLATE)
# ============================================
# Copy this file to .env and fill in REAL values there.
#   cp .env.example .env
# NEVER put real secrets in this file — .env.example is a shareable template.
# Only .env holds real values, and .env is gitignored.
# ============================================


# ----- GEMINI AI (Google GenAI) -----
GEMINI_API_KEY=your_gemini_key_here


# ----- VITE (Frontend) -----
# Blank for Vercel (auto-routes /api). For local dev the vite proxy handles it,
# so blank is fine locally too.
VITE_API_URL=


# ----- SERVER (Local Express Backend) -----
PORT=3001


# ----- JWT AUTHENTICATION -----
# Generate: openssl rand -hex 32
JWT_SECRET=generate_a_long_random_string
JWT_EXPIRES_IN=7d


# ----- MONGODB -----
# From Atlas -> Connect -> Drivers. Replace the FULL host (no "xxxxx" left).
# URL-encode special chars in the password (+ becomes %2B, @ becomes %40, etc.)
MONGODB_URI=mongodb+srv://<user>:<urlencoded-password>@<cluster>.mongodb.net/docuease?retryWrites=true&w=majority


# ----- SESSION / COOKIES (only if express-session is added) -----
SESSION_SECRET=generate_a_long_random_string


# ----- EMAIL / SMTP (Optional) -----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM="DocuEase <noreply@docuease.com>"


# ----- CLOUDINARY (Optional — file uploads) -----
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret


# ----- RAZORPAY (Optional — payments) -----
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret_here


# ----- CORS -----
# Comma-separated allowed origins. Include your real Vercel domain in prod.
CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app
